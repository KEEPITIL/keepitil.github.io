<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  ==== STAGED: Multicast Networking entitlement ====
	  Uncomment the two lines below ONLY in the build that ships once Apple has
	  granted com.apple.developer.networking.multicast on the App ID AND the
	  provisioning profile has been regenerated to carry it. Activating it
	  before then fails code signing ("provisioning profile doesn't include the
	  ...multicast entitlement"). Do NOT include this in v1.0.0(2) (in review).

	  <key>com.apple.developer.networking.multicast</key>
	  <true/>
	  ==== end staged ====
	-->

	<!-- Merge any keys your canonical Runner.entitlements already has (e.g.
	     aps-environment, keychain-access-groups) — do not drop them. -->
</dict>
</plist>
